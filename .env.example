# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Cryptographic Security Configuration
# JWT_SECRET: Minimum 32-character high-entropy secret for signing authentication tokens.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS"

# ---------------------------------------------------------------------------
# ADMIN credentials: Used to initialize the single system-owner admin account.
# Ensure a strong random password is set before starting the server.
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@marketminds.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD_123!"
ADMIN_DISPLAY_NAME="System Admin"

# MongoDB Database Connection Configuration
MONGODB_URI="MONGODB_URI"
MONGODB_DB="MONGODB_DB"
OWNER_ID="default-user"

# SMTP Email Verification Service Configuration (Optional)
# If left unconfigured, verification OTP codes will be printed to server console logs for local development
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="\"MarketMind Auth\" <your-email@gmail.com>"
